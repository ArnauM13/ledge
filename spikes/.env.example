# Copia aquest fitxer a spikes/.env (ja és al .gitignore) i omple'l.
# No hi posis mai la clau privada en si: només el CAMÍ a un fitxer FORA del repo.

# --- Enable Banking (gates G1, G2) ---
# Application ID que et dona el Control Panel en pujar el certificat (s'usa com a `kid` del JWT)
EB_APP_ID=
# Camí ABSOLUT a la clau privada RSA (PEM), fora del repo. El script s'atura si és dins del repo.
EB_PRIVATE_KEY_PATH=/home/<tu>/.secrets/ledge/enablebanking-private.pem
# URL de redirecció HTTPS registrada a l'app (ha de coincidir exactament)
EB_REDIRECT_URL=https://<el-teu-domini>/callback
# Opcional: capçaleres "PSU present". Només si ets davant de la pantalla i amb la TEVA IP pública real.
# EB_PSU_IP_ADDRESS=
# EB_PSU_USER_AGENT=

# --- Binance (gate G3) ---
# Clau amb NOMÉS "Enable Reading" i restricció d'IP. El script s'atura si té qualsevol altre permís.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Wallets (gate G4) ---
# Adreces PÚBLIQUES separades per comes. Mai seed phrases ni claus privades. Sense xpub en aquest spike.
BTC_ADDRESSES=
EVM_ADDRESSES=
# chainid separats per comes (1 = Ethereum, 42161 = Arbitrum One, 10 = OP, 8453 = Base, 137 = Polygon)
EVM_CHAINS=1
ETHERSCAN_API_KEY=
