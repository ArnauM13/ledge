# Copia aquest fitxer a .env (no es puja mai a git) i omple els valors.

# --- Enable Banking ---
# ID de l'app = nom del fitxer .pem que es descarrega en registrar-la (sense ".pem").
EB_APP_ID=
# Ruta ABSOLUTA a la clau privada. Ha d'estar FORA del repo. Pots fer servir ~.
EB_PRIVATE_KEY_PATH=~/.secrets/ledge/APP_ID.pem
# Ha de coincidir exactament amb la Redirect URL registrada a l'app.
EB_REDIRECT_URL=https://localhost:3000/callback
# Opcional. Per defecte: https://api.enablebanking.com
# EB_API_BASE=https://api.enablebanking.com

# Opcional (experimental): la teva IP pública. Si s'omple, eb:fetch envia les
# capçaleres Psu-Ip-Address i Psu-User-Agent (usuari present). Deixa-ho buit si no ho necessites.
# EB_PSU_IP_ADDRESS=

# --- Binance (gate G3) ---
# Clau amb NOMÉS "Enable Reading" i restricció d'IP. El script s'atura si té qualsevol altre permís.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Wallets (gate G4) ---
# Adreces PÚBLIQUES separades per comes. Mai seed phrases ni claus privades. Sense xpub en aquest spike.
BTC_ADDRESSES=
EVM_ADDRESSES=
# chainid separats per comes (1 = Ethereum, 42161 = Arbitrum One, 10 = OP, 8453 = Base, 137 = Polygon)
EVM_CHAINS=1
ETHERSCAN_API_KEY=
