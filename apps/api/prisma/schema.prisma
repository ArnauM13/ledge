// ledge — database schema (PostgreSQL).
// Conventions:
// - UUID primary keys generated by the database (gen_random_uuid(), PG >= 13).
// - Timestamps are `timestamptz`: an absolute instant, stored in UTC.
// - Tables and columns are snake_case; Prisma models are PascalCase/camelCase.
// - Every table with household_id has an index on it.
// The connection URL is built at runtime (src/app/config/database-url.ts):
// there is no `url` here and no DATABASE_URL anywhere.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  runtime                = "nodejs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Normalised (trimmed, lower-case) by the API before it is stored.
  email        String   @unique
  displayName  String   @map("display_name")
  /// argon2id PHC string. Never the password.
  passwordHash String   @map("password_hash")

  /// TOTP secret, AES-256-GCM encrypted (EncryptionService, AAD users.totp_secret.<id>).
  totpSecretEnc        String?   @map("totp_secret_enc")
  /// Secret being enrolled, encrypted; moved to totp_secret_enc once confirmed.
  totpPendingSecretEnc String?   @map("totp_pending_secret_enc")
  totpEnabledAt        DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step: a code can only be used once.
  totpLastUsedStep     BigInt?   @map("totp_last_used_step")

  /// Consecutive failed password/TOTP/recovery attempts (reset on success).
  failedAuthCount Int       @default(0) @map("failed_auth_count")
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(3)

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  auditLogs     AuditLog[]
  sessions      Session[]
  recoveryCodes RecoveryCode[]

  @@map("users")
}

model Household {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  auditLogs   AuditLog[]

  @@map("households")
}

enum MembershipRole {
  OWNER
  MEMBER

  @@map("membership_role")
}

model Membership {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId String         @map("household_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  role        MembershipRole @default(MEMBER)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Also serves as the household_id index (household_id is its first column).
  @@unique([householdId, userId])
  @@index([userId])
  @@map("memberships")
}

enum AuditOutcome {
  SUCCESS
  FAILURE

  @@map("audit_outcome")
}

/// Append-only: the API never updates or deletes rows (Prisma extension in
/// src/app/prisma), and a trigger in the database rejects UPDATE, DELETE and
/// TRUNCATE. No sensitive data: no passwords, codes, tokens, secrets or the
/// identifier typed for an unknown user.
model AuditLog {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Event name, e.g. `auth.login.password`.
  action      String
  outcome     AuditOutcome
  /// Machine-readable reason for failures, e.g. `invalid_credentials`.
  reason      String?
  /// Null when the user is unknown (failed login with a non-existing email).
  userId      String?      @map("user_id") @db.Uuid
  householdId String?      @map("household_id") @db.Uuid
  ip          String?
  userAgent   String?      @map("user_agent")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Always equal to created_at (rows never change); kept for consistency.
  updatedAt   DateTime     @default(now()) @map("updated_at") @db.Timestamptz(3)

  user      User?      @relation(fields: [userId], references: [id], onDelete: Restrict)
  household Household? @relation(fields: [householdId], references: [id], onDelete: Restrict)

  @@index([householdId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

enum SessionStage {
  /// Password checked; only the TOTP (or TOTP enrolment) endpoints are allowed.
  PASSWORD_VERIFIED
  /// Password + TOTP: full access.
  AUTHENTICATED

  @@map("session_stage")
}

/// Server-side sessions. The cookie holds a random token; only its SHA-256
/// is stored, so a database leak does not give working cookies.
model Session {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash  String       @unique @map("token_hash")
  userId     String       @map("user_id") @db.Uuid
  stage      SessionStage
  lastSeenAt DateTime     @map("last_seen_at") @db.Timestamptz(3)
  /// Absolute expiry, whatever the activity.
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz(3)
  ip         String?
  userAgent  String?      @map("user_agent")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One-time 2FA recovery codes. Only a SHA-256 of each code is stored (80-bit
/// random codes, so a fast hash is enough); the codes are shown once.
model RecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}
