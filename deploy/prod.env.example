# Copy to `.env` at the repo root ON THE VPS. Only NON-secret settings.
# Passwords and keys live in ./secrets/ (see secrets/README.md).

POSTGRES_USER=ledge
POSTGRES_DB=ledge
LEDGE_MASTER_KEY_VERSION=1

# Public HTTPS name of the VPS: its IP with dashes + .sslip.io
# (e.g. IP 203.0.113.10 -> 203-0-113-10.sslip.io). Caddy gets the certificate.
LEDGE_API_HOST=

# The web origin that calls the API through the Vercel rewrite.
WEB_ORIGINS=https://ledge-am.vercel.app

# Hops in front of the API: Vercel + Caddy.
API_TRUST_PROXY=2
