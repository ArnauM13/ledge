# Copy to `.env`. Only NON-secret settings go here.
# Passwords live in ./secrets/ (git-ignored), see README.md.

# PostgreSQL (docker compose only; not exposed outside the Docker network)
POSTGRES_USER=ledge
POSTGRES_DB=ledge

# API port published on 127.0.0.1 by docker compose
API_HOST_PORT=3000

# Version of the master key in secrets/ledge_master_key (not secret: it is
# written in every ciphertext). Bump it only when rotating the key, see
# secrets/README.md.
LEDGE_MASTER_KEY_VERSION=1

# Extra web origins allowed to call the API with state-changing requests
# (CSRF check), comma-separated, e.g. https://app.example.com. Same-origin
# requests (dev proxy, reverse proxy) need nothing here. Pending D4 (domain).
WEB_ORIGINS=

# Reverse-proxy hops to trust for the client IP used by the rate limits.
# Leave empty unless the API sits behind a proxy you control.
API_TRUST_PROXY=
